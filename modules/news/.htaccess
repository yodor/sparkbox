<IfModule mod_rewrite.c>
    RewriteEngine on
    #an item: <newsID>/<title slug>/
    RewriteRule ^([0-9]+)(/.*)?$ index.php?path=/view&newsID=$1 [QSA,L]
    #a month: archive/<year>/<month>/
    RewriteRule ^archive/([0-9]{4})/([0-9]{1,2})/?$ index.php?path=/archive&year=$1&month=$2 [QSA,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?path=/$1 [QSA,L]
</IfModule>
