# the front controller (sparkbox/modules/main) - put into the .htaccess of the site root, after the other rewrite
# rules. Addresses that are not a file or a folder go to the root index.php (Module::Route): the modules of the
# site config/routes.php by their folder, anything else the main module.
# Missing static files keep the server 404 instead of a page.
# The code and configuration folders of the site are not served (their scripts run only through the modules).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(class|config)(/|$) - [F,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !\.(css|js|mjs|map|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|otf|eot)$ [NC]
    RewriteRule ^(.*)$ index.php?path=/$1 [QSA,L]
</IfModule>
